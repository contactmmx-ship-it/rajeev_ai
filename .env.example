# Required — realtime voice
OPENAI_API_KEY=your_key_here

# V2 — real accounts (Supabase Auth, magic link). If either is missing,
# the app falls back to an anonymous browser-local identity instead of
# requiring sign-in — same as before V2 existed.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# V1 Memory Engine (V2-V7 all build on this). If either of these is
# missing, the app still runs — voice + interruption + live transcript
# all work — but nothing is remembered, and none of V3-V7 activate.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional — override the models used for realtime transcription and
# memory/methodology extraction. Safe to leave unset.
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
MEMORY_EXTRACTION_MODEL=gpt-5-mini

# V6 — where an APPROVED agent action actually gets dispatched. This is
# deliberately a generic webhook, not a specific vendor integration —
# point it at Zapier/Make/n8n/your own endpoint to make an approved
# action do something real. Leave unset and approving an action just
# marks it approved; execution will report "no webhook configured."
# AGENT_WEBHOOK_URL is the default for every agent; the per-agent
# overrides below take priority when set.
AGENT_WEBHOOK_URL=
# AGENT_WEBHOOK_URL_SALES=
# AGENT_WEBHOOK_URL_FINANCE=
# AGENT_WEBHOOK_URL_OPS=
# AGENT_WEBHOOK_URL_INVENTORY=
# AGENT_WEBHOOK_URL_PROCUREMENT=
# AGENT_WEBHOOK_URL_HR=
# AGENT_WEBHOOK_URL_STRATEGY=

# Optional — FKAIOS Brain bridge (read-only). When all three are set, this
# app also pulls what FKAIOS already knows about the person's company into
# the realtime session's instructions. Missing any of them -> "" -> this
# app behaves exactly as if the bridge didn't exist. See lib/fkaiosBrain.ts.
FKAIOS_FOUNDER_OBJECTIVE_URL=https://nrlsqshkjuuwiovthrnb.supabase.co/functions/v1/founder-objective
FKAIOS_SUPABASE_ANON_KEY=
FKAIOS_SERVICE_TOKEN=

